// The caller of the unit the p4_processes trial generates (erl_procs.silica). run_trials.sh writes MMM, the
// unit's message sum, into it (from the unit's to_silica_send), compiles it with the unit, Silica's Supervisor
// unit and a prelude unit (limitation observed: units agree on atom numbers only behind one), runs it and
// compares its standard output with expected.txt. Standard error must hold the failure report of the echo
// process that is told to fail (reason kaboom).
//
// The probe is this caller's own actor. Its message type is the unit's message sum, it casts tagged tuples as
// the unit's processes do, and it is the watcher of the processes it starts with <function>__spawn_watched: the
// value such a process ends with comes back as (:to_silica_result_<type>, value).
use erl_procs;

fn region_dump_limit() -> int64 {
    0
}

fn reporter(report: string, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case contains(report, ":normal") of {
            true -> :ok;
            false -> println_stderr(report)
        }
    produces pure (:no_reply, state) end
}

fn int_line(step: int64, text: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print("step ");
        _: atom <- print_int64(step);
        _: atom <- print(text);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces pure o end
}

fn atom_line(step: int64, text: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print("step ");
        _: atom <- print_int64(step);
        _: atom <- print(text);
        o: atom <- println(atom_name(a))
    produces pure o end
}

fn next_step(n: int64, ms: uint64) -> boolean {
    sequence proc[concurrency]
        _: timer_ref <- send_after(ms, self(), (:to_silica_timeout, n) impl ActorMessage {})
    produces pure true end
}

fn me() -> actor_ref {
    sequence proc[concurrency]
        a: actor_ref <- self()
    produces pure a end
}

fn probe(msg: MMM, state: { step: int64, e: actor_ref }) -> (:no_reply, { step: int64, e: actor_ref }) {
    case msg of {
        // step 1: start_echo(); {say, self(), 5} and {say, self(), 0}
        (:to_silica_go, _z: int64) -> {
            sequence proc[concurrency]
                e: actor_ref <- erl_procs@start_echo();
                _: boolean <- cast(e, (:say, self(), 5) impl ActorMessage {});
                _: boolean <- cast(e, (:say, self(), 0) impl ActorMessage {});
                _: boolean <- next_step(2, 250)
            produces pure (:no_reply, { step: 1, e: e }) end
        };
        (:to_silica_timeout, n: int64) -> case n of {
            // step 2: ask(41) asks an echo of its own and ends with the answer
            2 -> {
                _: actor_ref <- erl_procs@ask__spawn_watched(41, me());
                _: boolean <- next_step(3, 250);
                (:no_reply, { step: 2, e: state.e })
            };
            // step 3: wait(100) ends with late after 100 ms
            3 -> {
                _: actor_ref <- erl_procs@wait__spawn_watched(100, me());
                _: boolean <- next_step(4, 400);
                (:no_reply, { step: 3, e: state.e })
            };
            // step 4: twice(21) does not receive; as a process it ends with its value
            4 -> {
                _: actor_ref <- erl_procs@twice__spawn_watched(21, me());
                _: actor_ref <- erl_procs@start_add();
                _: boolean <- next_step(5, 250);
                (:no_reply, { step: 4, e: state.e })
            };
            // step 5: relay(E) waits for go, goes on in forward(E), which passes {say, self(), 7} on to the echo
            5 -> {
                sequence proc[concurrency]
                    r: actor_ref <- erl_procs@relay__spawn_watched(state.e, self());
                    _: boolean <- cast(r, (:to_silica_sym, :go) impl ActorMessage {});
                    _: boolean <- cast(r, (:say, self(), 7) impl ActorMessage {});
                    _: boolean <- next_step(6, 250)
                produces pure (:no_reply, { step: 5, e: state.e }) end
            };
            // step 6: ten more processes, one after the other: the pool has 8 child ids, so ids are used again
            6 -> {
                _: actor_ref <- erl_procs@twice__spawn_watched(100, me());
                _: boolean <- next_step(7, 1500);
                (:no_reply, { step: 100, e: state.e })
            };
            // step 7: notify(E) sends stop to the echo and answers the message
            7 -> {
                _: atom <- atom_line(7, ": notify(E) = ", erl_procs@notify(state.e));
                _: boolean <- next_step(8, 250);
                (:no_reply, { step: 7, e: state.e })
            };
            // step 8: kill(W) ends a wait(300) before its timeout: no "ended with late" comes for step 8;
            // spare(V) (the reason normal) does nothing to another wait(300), which ends with late
            8 -> {
                w: actor_ref <- erl_procs@wait__spawn_watched(300, me());
                _: atom <- atom_line(8, ": kill(W) = ", erl_procs@kill(w));
                _: boolean <- next_step(9, 600);
                (:no_reply, { step: 8, e: state.e })
            };
            9 -> {
                v: actor_ref <- erl_procs@wait__spawn_watched(300, me());
                _: atom <- atom_line(9, ": spare(V) = ", erl_procs@spare(v));
                _: boolean <- next_step(10, 600);
                (:no_reply, { step: 9, e: state.e })
            };
            // step 10: an echo that is told to fail ends with the reason kaboom (the reporter writes it to stderr)
            // (blow(E2) sends it boom: a symbol whose hint states the whole message type)
            10 -> {
                e2: actor_ref <- erl_procs@echo__spawn();
                _: atom <- erl_procs@blow(e2);
                _: boolean <- next_step(11, 400);
                (:no_reply, { step: 10, e: state.e })
            };
            // step 11: mid2() is a function cut at its receive by its sender (contract T9.13a): it takes {said, 41}
            // and goes on in mid2__k1(41), whose value 42 the process ends with; say(7) prints through (:sl_call)
            11 -> {
                sequence proc[concurrency]
                    m: actor_ref <- erl_procs@mid2__spawn_watched(self());
                    _: boolean <- cast(m, (:said, 41) impl ActorMessage {});
                    _: atom <- erl_procs@say(7);
                    _: boolean <- next_step(12, 400)
                produces pure (:no_reply, { step: 11, e: state.e }) end
            };
            // step 12: keep() reaches the (:register) of the static child `keeper` (an echo the supervisor has had
            // in its child list since it started); tell_keeper(5) sends to the name, and the echo answers
            12 -> {
                _: atom <- erl_procs@keep();
                _: atom <- erl_procs@tell_keeper(5);
                _: boolean <- next_step(13, 300);
                (:no_reply, { step: 12, e: state.e })
            };
            // step 13: the static child is told to fail (kaboom): it is transient, so the supervisor starts it again
            13 -> {
                _: atom <- erl_procs@blow_keeper();
                _: boolean <- next_step(14, 400);
                (:no_reply, { step: 13, e: state.e })
            };
            // step 14: the name is the new child's: it answers
            14 -> {
                _: atom <- erl_procs@tell_keeper(8);
                _: boolean <- next_step(15, 300);
                (:no_reply, { step: 14, e: state.e })
            };
            _: int64 -> {
                sequence proc[concurrency]
                    _: boolean <- cast_exit(0)
                produces pure (:no_reply, state) end
            }
        };
        (:said, n: int64) -> {
            _: atom <- int_line(state.step, ": received {said, N}, N = ", n);
            (:no_reply, state)
        };
        (:to_silica_result_int64, n: int64) -> case state.step >= 100 of {
            false -> {
                _: atom <- int_line(state.step, ": the process ended with ", n);
                (:no_reply, state)
            };
            true -> case state.step >= 109 of {
                true -> {
                    _: atom <- int_line(6, ": processes run one after the other = ", state.step - 99);
                    (:no_reply, { step: 6, e: state.e })
                };
                false -> {
                    _: actor_ref <- erl_procs@twice__spawn_watched(n, me());
                    (:no_reply, { step: state.step + 1, e: state.e })
                }
            }
        };
        (:to_silica_result_atom, a: atom) -> {
            _: atom <- atom_line(state.step, ": the process ended with ", a);
            (:no_reply, state)
        };
        _: MMM -> (:no_reply, state)
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rep: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rep);
        _: boolean <- erl_procs@to_silica_start();
        p: actor_ref <- spawn({ step: 0, e: actor_ref_of_word(0) }, probe, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(p, (:to_silica_go, 0) impl ActorMessage {});
        code: int64 <- wait_for_exit()
    produces pure code end
}
