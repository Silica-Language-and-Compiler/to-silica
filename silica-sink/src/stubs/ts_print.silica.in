// INTERFACE ONLY (silica-sink/build.sh, "why several compiler runs"): the exported signatures of ts_print that the
// transpile actor calls. The linked program holds the real ts_print. build.sh checks that every `fn` line here is
// also in the real unit.
module ts_print;

export unit_rest/6;
export unit_notes/2;

fn unit_rest(silica_unit: string, d: string, exports: string, text: string, sigs: string, entry: string) -> string {
    concat(concat(silica_unit, d), concat(concat(exports, text), concat(sigs, entry)))
}

fn unit_notes(text: string, kind: string) -> string {
    concat(text, kind)
}
