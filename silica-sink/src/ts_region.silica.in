fn t_end(r: int64, attempt: int64) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@transpile_name(r), (:t_end, attempt) impl ActorMessage {})
    produces
        pure b
    end
}

fn own(state: $OWNER_STATE$, io: $OWNER_IO$, job: $JOB$) -> $OWNER_STATE$ {
    { car: state.car, r: state.r, rx: state.rx, io: io, job: job }
}

fn own_rx(state: $OWNER_STATE$, rx: $RX$) -> $OWNER_STATE$ {
    { car: state.car, r: state.r, rx: rx, io: state.io, job: state.job }
}

fn io_next(io: $OWNER_IO$, next: int64) -> $OWNER_IO$ {
    { up: io.up, closing: io.closing, next: next, oldest: io.oldest, rx_credit: io.rx_credit, waits: io.waits, mode: io.mode, free_slot: io.free_slot, free_token: io.free_token }
}

fn io_waits(io: $OWNER_IO$, waits: $LI$) -> $OWNER_IO$ {
    { up: io.up, closing: io.closing, next: io.next, oldest: io.oldest, rx_credit: io.rx_credit, waits: waits, mode: io.mode, free_slot: io.free_slot, free_token: io.free_token }
}

fn io_mode(io: $OWNER_IO$, mode: int64, rx_credit: int64) -> $OWNER_IO$ {
    { up: io.up, closing: io.closing, next: io.next, oldest: io.oldest, rx_credit: rx_credit, waits: io.waits, mode: mode, free_slot: io.free_slot, free_token: io.free_token }
}

fn io_free(io: $OWNER_IO$, slot: int64, token: int64) -> $OWNER_IO$ {
    { up: io.up, closing: io.closing, next: io.next, oldest: io.oldest, rx_credit: io.rx_credit, waits: io.waits, mode: io.mode, free_slot: slot, free_token: token }
}

fn job_phase(job: $JOB$, phase: int64) -> $JOB$ {
    { phase: phase, slot: job.slot, token: job.token, id: job.id, base: job.base, hello: job.hello, attempt: job.attempt, tally: job.tally, result: job.result, pending: job.pending }
}

fn job_attached(job: $JOB$, phase: int64, slot: int64, token: int64) -> $JOB$ {
    { phase: phase, slot: slot, token: token, id: job.id, base: job.base, hello: job.hello, attempt: job.attempt, tally: job.tally, result: job.result, pending: job.pending }
}

fn job_attempt(job: $JOB$, attempt: int64) -> $JOB$ {
    { phase: job.phase, slot: job.slot, token: job.token, id: job.id, base: job.base, hello: job.hello, attempt: attempt, tally: job.tally, result: job.result, pending: job.pending }
}

fn job_done(job: $JOB$, result: string, pending: string) -> $JOB$ {
    { phase: job.phase, slot: job.slot, token: job.token, id: job.id, base: job.base, hello: job.hello, attempt: job.attempt, tally: job.tally, result: result, pending: pending }
}

// Appends an own record and counts it.
fn put_own(state: $OWNER_STATE$, etf: string) -> $OWNER_STATE$ {
    n: int64 <- append(state.car, ts_records@own_schema(), etf);
    own(state, io_next(state.io, state.io.next + n), state.job)
}

// Asks the store to make everything durable; code says what the answer is for (io.waits).
fn sync_for(state: $OWNER_STATE$, code: int64) -> $OWNER_STATE$ {
    _: boolean <- car_sync(state.car);
    own(state, io_waits(state.io, push_wait(state.io.waits, code)), state.job)
}

// One more receive credit to the store.
fn grant(state: $OWNER_STATE$) -> $OWNER_STATE$ {
    _: boolean <- car_credit(state.car);
    own(state, io_mode(state.io, state.io.mode, state.io.rx_credit + 1), state.job)
}

// How many records of a replay may be on their way at once: ONE, whatever the replay is for (io.mode).
// Why: a cast to an ended actor ends the sender (limitation observed), and a transpile actor that fails on a
// record is gone until its supervisor has restarted it. With a window of records on their way, the owner cast the
// records after the fatal one to the ended actor and ended itself; whether it did was a matter of timing (it did
// not with compiler 999919 and did with 999916, 2026-11-13). With one record on its way the owner casts the next
// only after (:t_more, ...), which a failed actor never sends. The window is one for every mode because credit a
// replay leaves unused stays with the store for the next replay (begin_read). It costs nothing measured: a record
// took some 30 ms to come from a (:backing) region with a window of 32 as with one (STATUS.md).
fn window(_mode: int64) -> int64 {
    1
}

// One record of a replay has arrived: one credit less is out.
fn took(state: $OWNER_STATE$) -> $OWNER_STATE$ {
    own(state, io_mode(state.io, state.io.mode, state.io.rx_credit - 1), state.job)
}

// Starts a replay from store record `from` (one at a time: the callers see to it that none is in progress) and
// gives the store its window of receive credit, less what an earlier replay left unused.
fn begin_read(state: $OWNER_STATE$, from: int64, mode: int64) -> $OWNER_STATE$ {
    _: boolean <- car_read(state.car, from);
    _: boolean <- case state.io.rx_credit < window(mode) of {
        true -> car_credits(state.car, window(mode) - state.io.rx_credit);
        false -> true
    };
    credit: int64 <- case state.io.rx_credit < window(mode) of {
        true -> window(mode);
        false -> state.io.rx_credit
    };
    { car: state.car, r: state.r, rx: wireframe@fresh(Carrier@boundaries(:store)), io: io_mode(state.io, mode, credit), job: state.job }
}
