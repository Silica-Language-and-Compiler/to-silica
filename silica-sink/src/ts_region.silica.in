fn tx_segments(cs: int64, segs: $LS$, n: int64) -> int64 {
    case segs of {
        []: $LS$ -> n;
        [seg: string, t: $LS$] -> {
            _: boolean <- car_tx(cs, seg);
            tx_segments(cs, t, n + 1)
        }
    }
}

// Appends one value's bytes to the region as a stored record (app design 4.1): wireframe@record with the ETF
// format id and the schema number, cut into the store's records by wireframe's :storage mode. Answers how many
// store records it took.
fn append(cs: int64, schema: int64, etf: string) -> int64 {
    tx_segments(cs, wireframe@frame(wireframe@record(:etf, schema, etf), Carrier@mtu(:store), Carrier@boundaries(:store)), 0)
}

// To the session actor in slot (nothing when the job is detached).
fn tell(slot: int64, token: int64, kind: atom, text: string, num: int64) -> boolean {
    case slot < 0 of {
        true -> false;
        false -> {
            sequence proc[concurrency]
                b: boolean <- cast_registered(ts_pool@session_name(slot), (:store, token, kind, text, num) impl ActorMessage {})
            produces
                pure b
            end
        }
    }
}

fn tell_rebuild(slot: int64, token: int64, schema: int64, record: string) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@session_name(slot), (:rebuild, token, schema, record) impl ActorMessage {})
    produces
        pure b
    end
}

