// ts_region: what a store owner (ts_actor_store) does to its region and to the other actors: the commands to the
// region's port (dangerous_ts_port, which owns the store carrier), appending a record, the messages to the session
// and transpile actors, and the owner's state with its small changes. It is a unit of its own only to keep each
// unit within what one compiler run can hold (STATUS.md, "Compiler memory").
//
// Source file: ts_region.silica.in; the $NAME$ placeholders are spelled out by silica-sink/tools/expand.py.
module ts_region;

use wire_etf;
use wireframe;
use Carrier;
use ts_pool;
use ts_records;

export no_waits/0;
export push_wait/2;
export idle_job/0;
export owner_initial/1;
export car_tx/2;
export car_sync/1;
export car_read/2;
export car_read_stop/1;
export car_credit/1;
export car_trim/2;
export car_close/1;
export car_boot/1;
export append/3;
export tell/5;
export tell_rebuild/4;
export t_start/3;
export t_record/3;
export t_end/2;
export own/3;
export own_rx/2;
export io_next/2;
export io_waits/2;
export io_mode/3;
export io_free/3;
export job_phase/2;
export job_attached/4;
export job_attempt/2;
export job_done/3;
export put_own/2;
export sync_for/2;
export grant/1;
export begin_read/3;
export took/1;
export window/1;

fn no_waits() -> $LI$ {
    sequence proc[mem(normal)]
        out: $LI$ <- empty[int64, mem(normal)]()
    produces
        pure out
    end
}

fn push_wait(ws: $LI$, code: int64) -> $LI$ {
    case ws of {
        []: $LI$ -> {
            sequence proc[mem(normal)]
                out: $LI$ <- prepend[int64, mem(normal)](code, no_waits())
            produces
                pure out
            end
        };
        [w: int64, t: $LI$] -> {
            sequence proc[mem(normal)]
                rest: $LI$ <- push_wait(t, code);
                out: $LI$ <- prepend[int64, mem(normal)](w, rest)
            produces
                pure out
            end
        }
    }
}

fn idle_job() -> $JOB$ {
    { phase: 0, slot: 0 - 1, token: 0, id: "", base: 0, hello: "", attempt: 0, tally: { rejected: 0, frames: 0, miscounts: 0 }, result: "", pending: "" }
}

fn owner_initial(r: int64) -> $OWNER_STATE$ {
    { car: r, r: r, rx: wireframe@fresh(Carrier@boundaries(:store)),
      io: { up: false, closing: false, next: 0, oldest: 0, rx_credit: 0, waits: no_waits(), mode: 0, free_slot: 0 - 1, free_token: 0 },
      job: idle_job() }
}

fn car_tx(r: int64, seg: string) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@port_name(r), (:p_tx, seg) impl ActorMessage {})
    produces
        pure b
    end
}

fn car_sync(r: int64) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@port_name(r), (:p_sync, 0) impl ActorMessage {})
    produces
        pure b
    end
}

fn car_read(r: int64, from: int64) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@port_name(r), (:p_read, from) impl ActorMessage {})
    produces
        pure b
    end
}

