// ts_actor_transpile: the transpile actors (app design 3.4, 6) and their supervisor.
// The tree, the restart rules and the messages between the actors are described in dangerous_to_silica.
//
// Source file: ts_actor_transpile.silica.in; the $NAME$ placeholders are spelled out by silica-sink/tools/expand.py.
module ts_actor_transpile;

use Supervisor;
use wire_etf;
use ts_text;
use ts_config;
use ts_pool;
use ts_reply;
use ts_print;
use ts_intake;
use tcp_transport_v1;

export transpile_sup/1;

impl ts_actor_transpile for Supervisor;

//
// One per region, idle between sessions. The store owner replays the session's stored frames to it, one at a
// time; it decodes each again (the store is untrusted on the way back, app design 7), prints a unit at a time and
// hands each output file to the store owner, which owns the carrier.

fn no_unit() -> $UNIT_ACC$ {
    { silica_unit: "", name: "", exports: "", text: "", sigs: "", entry: "", stubs: false }
}

fn transpile_initial(r: int64) -> $TRANSPILE_STATE$ {
    { r: r, attempt: 0, silica: false, acc: no_unit(), n: { units: 0, gaps: 0, files: 0, written: 0 }, diag: "", decls: "" }
}

fn to_owner_more(r: int64, attempt: int64) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@store_name(r), (:t_more, attempt) impl ActorMessage {})
    produces
        pure b
    end
}

fn to_owner_out(r: int64, attempt: int64, path: string, content: string) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@store_name(r), (:t_out, attempt, path, content) impl ActorMessage {})
    produces
        pure b
    end
}

fn to_owner_done(state: $TRANSPILE_STATE$, status: atom) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@store_name(state.r), (:t_done, state.attempt, status, state.n.units, state.n.gaps, state.n.files, state.diag) impl ActorMessage {})
    produces
        pure b
    end
}

fn to_owner_boot(r: int64) -> boolean {
    sequence proc[concurrency]
        b: boolean <- cast_registered(ts_pool@store_name(r), (:t_boot, r) impl ActorMessage {})
    produces
        pure b
    end
}

// The unit's file: the printer writes everything after the `module` line (the exports, the helper functions, the
// forms, and for a unit with processes the process runtime; main when the entry function is in the unit).
fn unit_text(u: $UNIT_ACC$, decls: string) -> string {
    concat(ts_text@concat4("// Generated by to-silica (provisional printer) from the unit ", u.name, ". Do not edit.\nmodule ", u.silica_unit),
           concat(";\n\n", ts_print@unit_rest(u.silica_unit, decls, u.exports, u.text, u.sigs, u.entry)))
}

// The result type in a printed function's first line: the text between ") -> " and " {".
fn result_type(text: string) -> string {
    a: int64 <- ts_text@find(text, ") -> ", 0);
    b: int64 <- ts_text@find(text, " {\n", 0);
    case a >= 0 and b > a + 5 of {
        true -> substring(text, a + 5, b);
        false -> ""
    }
}

// u.sigs holds, for every function written in the unit (in full or as a stub), "\x02name/arity\x03result type\x04".
fn signed(sigs: string, p: $PRINTED$) -> string {
    concat(ts_text@concat4(sigs, "\x02", p.sig, "\x03"), concat(result_type(p.text), "\x04"))
}

fn status_of(n: $TALLY$) -> atom {
    case n.files == 0 of {
        true -> :failed;
        false -> case n.gaps == 0 of {
            true -> :ok;
            false -> :partial
        }
    }
}

fn with_acc(state: $TRANSPILE_STATE$, acc: $UNIT_ACC$, n: $TALLY$, diag: string) -> $TRANSPILE_STATE$ {
    { r: state.r, attempt: state.attempt, silica: state.silica, acc: acc, n: n, diag: diag, decls: state.decls }
}

// A (:type) form adds its declaration to the session's declared types, the newest first (contract T8.14). The
// table lasts for the session: a later unit may name a type an earlier unit declared.
fn with_decl(state: $TRANSPILE_STATE$, g: $DIGEST$) -> $TRANSPILE_STATE$ {
    case length_bytes(g.printed.decl) == 0 of {
        true -> state;
        false -> { r: state.r, attempt: state.attempt, silica: state.silica, acc: state.acc, n: state.n, diag: state.diag, decls: concat(ts_text@fresh(g.printed.decl), state.decls) }
    }
}

// Missing or inconsistent typing (T31xx, contract T8.13) is the sender's fault and an error; a gap is a warning.
fn severity_of(code: string) -> atom {
    case starts_with(code, "T31") of {
        true -> :error;
        false -> :warning
    }
}

// A form the printer wrote in full. A code with it (T4004) is a warning about what was written: a diagnostic, no gap.
fn printed_form(g: $DIGEST$, state: $TRANSPILE_STATE$) -> $TRANSPILE_STATE$ {
    with_acc(state,
             { silica_unit: state.acc.silica_unit, name: state.acc.name, exports: concat(state.acc.exports, g.printed.exports), text: ts_text@concat3(state.acc.text, g.printed.text, "\n"),
               sigs: signed(state.acc.sigs, g.printed), entry: state.acc.entry, stubs: state.acc.stubs },
             { units: state.n.units, gaps: state.n.gaps, files: state.n.files, written: state.n.written + 1 },
             case length_bytes(g.printed.code) == 0 of {
                 true -> state.diag;
                 false -> concat(state.diag, ts_reply@placed_frame(g.seq, g.name, :warning, g.printed.code, ts_text@concat3(g.text, ": ", g.printed.why), g.printed.at.file, g.printed.at.line, g.printed.at.column))
             })
}

// The gaps one unwritten form adds to Result.counts.gaps: the gaps its sender sent in it (the number a check
// session counts, contract T6.11), or 1 when the sender sent none and the transpiler itself could not print it.
fn gaps_of(g: $DIGEST$) -> int64 {
    case g.check.gaps > 0 of {
        true -> g.check.gaps;
        false -> 1
    }
}

fn code_of(p: $PRINTED$) -> string {
    case length_bytes(p.code) == 0 of {
        true -> "T4002";
        false -> p.code
    }
}

// A form that is a gap (contract T9.10): a failing stub when the printer could write one, otherwise a comment.
fn gap_form(g: $DIGEST$, state: $TRANSPILE_STATE$) -> $TRANSPILE_STATE$ {
    why: string <- ts_text@concat3(g.text, " is a gap: ", g.printed.why);
    slash: int64 <- ts_text@find(g.text, "/", 0);
    // A form of which nothing is written is marked for the printer, which makes a failing stub of every function
    // of the unit that calls it (ts_print@unit_rest).
    note: string <- concat(ts_text@concat3("// gap: ", why, "\n"), case g.printed.stub of {
        true -> "";
        false -> ts_text@concat3("//@to_silica missing\t", case slash < 0 of {
            true -> g.text;
            false -> substring(g.text, 0, slash)
        }, "\n")
    });
    with_acc(state,
             { silica_unit: state.acc.silica_unit, name: state.acc.name, exports: concat(state.acc.exports, g.printed.exports),
               text: case g.printed.stub of {
                   true -> concat(ts_text@concat4(state.acc.text, note, g.printed.text, "\n"), "");
                   false -> ts_text@concat3(state.acc.text, note, "\n")
               },
               sigs: case g.printed.stub of {
                   true -> signed(state.acc.sigs, g.printed);
                   false -> state.acc.sigs
               },
               entry: state.acc.entry, stubs: state.acc.stubs or g.printed.stub },
             { units: state.n.units, gaps: state.n.gaps + gaps_of(g), files: state.n.files,
               written: case g.printed.stub of {
                   true -> state.n.written + 1;
                   false -> state.n.written
               } },
             concat(state.diag, ts_reply@placed_frame(g.seq, g.name, severity_of(code_of(g.printed)), code_of(g.printed), why, g.printed.at.file, g.printed.at.line, g.printed.at.column)))
}

// The unit's (:entry, ...) form (contract T9.6): main is written at the unit's end when the entry function was
// written in this unit with no parameters; otherwise the entry is a gap.
fn entry_form(g: $DIGEST$, state: $TRANSPILE_STATE$) -> $TRANSPILE_STATE$ {
    with_acc(state,
             { silica_unit: state.acc.silica_unit, name: state.acc.name, exports: state.acc.exports, text: state.acc.text, sigs: state.acc.sigs,
               entry: ts_text@fresh(substring(g.text, 6, length_bytes(g.text))), stubs: state.acc.stubs },
             state.n, state.diag)
}

fn fault_always(g: $DIGEST$) -> boolean {
    g.kind == :unit_begin and length_bytes(ts_config@fault_transpile_always()) > 0 and g.name == ts_config@fault_transpile_always()
}

fn fault_once(g: $DIGEST$, attempt: int64) -> boolean {
    g.kind == :unit_begin and attempt == 1 and length_bytes(ts_config@fault_transpile_once()) > 0 and g.name == ts_config@fault_transpile_once()
}

// The unit is complete: its file goes to the store owner. A unit in which nothing could be written gives no file.
fn close_unit(g: $DIGEST$, state: $TRANSPILE_STATE$) -> $TRANSPILE_STATE$ {
    text: string <- unit_text(state.acc, state.decls);
    has_main: boolean <- contains(text, "\nfn main() -> int64 {");
    entry_gap: boolean <- length_bytes(state.acc.entry) > 0 and not has_main;
    notes: string <- ts_print@unit_notes(text, "NOTE");
    choices: string <- ts_print@unit_notes(text, "CHOICE");
    diag0: string <- case entry_gap of {
        true -> concat(state.diag, ts_reply@finding_frame(g.seq, g.name, :warning, "T4002", ts_text@concat3("the entry point ", state.acc.entry, " is a gap: main is written only for an entry function of this unit that was written and takes no parameters")));
        false -> state.diag
    };
    // What the printer found only when it had the whole unit (a spawned function the unit does not have, ...).
    diag1: string <- case length_bytes(notes) == 0 of {
        true -> diag0;
        false -> concat(diag0, ts_reply@finding_frame(g.seq, g.name, :warning, "T4002", ts_text@concat3("in the unit ", state.acc.name, concat(": ", notes))))
    };
    // Lowering choices of the session that the unit's process runtime does not follow (contract T7.5).
    diag: string <- case length_bytes(choices) == 0 of {
        true -> diag1;
        false -> concat(diag1, ts_reply@finding_frame(g.seq, g.name, :warning, "T2001", ts_text@concat3("in the unit ", state.acc.name, concat(": ", choices))))
    };
    gaps0: int64 <- case entry_gap of {
        true -> state.n.gaps + 1;
        false -> state.n.gaps
    };
    gaps: int64 <- case length_bytes(notes) == 0 of {
        true -> gaps0;
        false -> gaps0 + 1
    };
    case state.n.written > 0 of {
        false -> with_acc(state, no_unit(), { units: state.n.units, gaps: gaps, files: state.n.files, written: 0 },
                          concat(diag, ts_reply@finding_frame(g.seq, g.name, :error, "T4003", ts_text@concat3("nothing of the unit ", state.acc.name, " could be written; it has no output file"))));
        true -> {
            _: boolean <- to_owner_out(state.r, state.attempt, concat(state.acc.silica_unit, ".silica"), text);
            with_acc(state, no_unit(), { units: state.n.units, gaps: gaps, files: state.n.files + 1, written: 0 }, diag)
        }
    }
}

// One replayed frame of the session, printed (app design 6).
fn transpile(g: $DIGEST$, state: $TRANSPILE_STATE$) -> $TRANSPILE_STATE$ {
    case g.kind of {
        // The session's context for the printer travels in decls beside the declared types (ts_print, "THE
        // SESSION'S CONTEXT"): the hello's lowering choices, and the name of the unit being printed (the newest first).
        :hello -> { r: state.r, attempt: state.attempt, silica: g.flags.silica, acc: state.acc, n: state.n, diag: state.diag, decls: ts_text@concat3("\x1d", ts_text@fresh(g.printed.text), "\x1e") };
        :unit_begin -> { r: state.r, attempt: state.attempt, silica: state.silica,
                         acc: { silica_unit: ts_text@fresh(g.text), name: ts_text@fresh(g.name), exports: "", text: "", sigs: "", entry: "", stubs: false },
                         n: { units: state.n.units + 1, gaps: state.n.gaps, files: state.n.files, written: 0 }, diag: state.diag,
                         decls: concat(ts_text@concat3("\x1c", ts_text@fresh(g.name), "\x1f"), state.decls) };
        :form -> case starts_with(g.text, "entry ") of {
            true -> entry_form(g, state);
            false -> case g.printed.ok of {
                true -> with_decl(printed_form(g, state), g);
                false -> with_decl(gap_form(g, state), g)
            }
        };
        :unit_end -> close_unit(g, state);
        _: atom -> state
    }
}

fn transpiler(msg: $TRANSPILE_EVENT$, state: $TRANSPILE_STATE$) -> (:no_reply, $TRANSPILE_STATE$) {
    case msg of {
        (:boot, _z: int64) -> {
            _: boolean <- to_owner_boot(state.r);
            (:no_reply, state)
        };
        (:t_start, attempt: int64, _id: string) -> (:no_reply, { r: state.r, attempt: attempt, silica: false, acc: no_unit(), n: { units: 0, gaps: 0, files: 0, written: 0 }, diag: "", decls: "" });
        (:t_record, attempt: int64, frame: string) -> case attempt == state.attempt of {
            false -> (:no_reply, state);
            true -> {
                g: $DIGEST$ <- ts_intake@digest(tcp_transport_v1@decode_to_transpiler(frame), state.silica, :print, state.decls);
                case fault_always(g) or fault_once(g, attempt) of {
                    true -> {
                        sequence proc[concurrency]
                            _: atom <- fail_self(:trial_fault)
                        produces
                            pure (:no_reply, state)
                        end
                    };
                    false -> {
                        after: $TRANSPILE_STATE$ <- transpile(g, state);
                        _: boolean <- to_owner_more(state.r, attempt);
                        (:no_reply, after)
                    }
                }
            }
        };
        (:t_end, attempt: int64) -> case attempt == state.attempt of {
            false -> (:no_reply, state);
            true -> {
                _: boolean <- to_owner_done(state, status_of(state.n));
                (:no_reply, state)
            }
        }
    }
}

fn flags(count: int64) -> $FLAGS$ {
    { strategy: :one_for_one, allowed_restart_count: count, restarts_time_frame: 10 }
}

// The transpile actors: one_for_one, at most 8 restarts in 10 seconds.
fn init(initial_state: int64) -> $TRANSPILE_SUP$ {
    sequence proc[mem(normal)]
        f: $FLAGS$ <- flags(8);
        children: $TRANSPILE_SPECS$ <- [
$TRANSPILE_CHILDREN$
        ]
    produces
        pure (f, children)
    end
}

// What the root supervisor names as this supervisor's behaviour (a child supervisor of another unit must be a
// unit's own Supervisor implementation).
fn transpile_sup(initial_state: int64) -> $TRANSPILE_SUP$ {
    init(initial_state)
}
