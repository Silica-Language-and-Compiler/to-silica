% bees.config of node xf@localhost (BEAM mode, cookie, EPMD on port 4369), written by hand for mesh6_f.silica.
[ {mode, beam},
  {node, [{name, "xf@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 0}, {epmd, external}, {epmd_port, 4369}, {net_ticktime_s, 60}, {redial, true}, {redial_initial_ms, 250}, {redial_max_ms, 4000},
          {peers, [
            {"xa@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]},
            {"xb@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]},
            {"xc@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]},
            {"xd@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]},
            {"xe@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]}]}]} ].
